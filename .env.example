# Local development defaults. Replace every placeholder before use.
NODE_ENV=development
STORAGE_BACKEND=json

ADMIN_PIN=change-this-to-a-unique-admin-secret
JUDGE_PIN=change-this-to-a-different-judge-secret
ADMIN_NAME=George
JUDGE_NAME=Judge

# Required only when enabling the separate media-team uploader.
MEDIA_UPLOAD_PASSWORD=

# Uncomment and replace when STORAGE_BACKEND=supabase; keep the key server-side.
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Required for participant-photo and gallery uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: set this when deploying the app under a path prefix.
FIGMA_PUBLIC_URL=
